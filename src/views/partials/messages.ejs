<% if (errors && errors.length > 0) { %>
  <div class="alert alert-error">
    <ul>
      <% errors.forEach(function(error) { %>
        <li><%= error %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success">
    <p><%= success %></p>
  </div>
<% } %>
