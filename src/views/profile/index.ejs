<%- include('../partials/header') %>

<div class="form-card">
  <h1>Profile</h1>

  <%- include('../partials/messages', { errors: errors, success: success }) %>

  <div class="profile-info">
    <p><strong>Name:</strong> <%= user.name %></p>
    <p><strong>Email:</strong> <%= user.email %></p>
    <p><strong>Status:</strong> <%= user.isActive ? 'Active' : 'Inactive' %></p>
  </div>

  <div class="tabs">
    <button class="tab-btn <%= activeTab === 'name' ? 'active' : '' %>" onclick="openTab('name')">Change Name</button>
    <button class="tab-btn <%= activeTab === 'password' ? 'active' : '' %>" onclick="openTab('password')">Change Password</button>
    <button class="tab-btn <%= activeTab === 'email' ? 'active' : '' %>" onclick="openTab('email')">Change Email</button>
  </div>

  <div id="name" class="tab-content <%= activeTab === 'name' ? 'active' : '' %>">
    <form action="/profile/name" method="POST">
      <div class="form-group">
        <label for="name">New Name</label>
        <input type="text" id="name" name="name" value="<%= user.name %>" required>
      </div>
      <button type="submit" class="btn btn-primary">Update Name</button>
    </form>
  </div>

  <div id="password" class="tab-content <%= activeTab === 'password' ? 'active' : '' %>">
    <form action="/profile/password" method="POST">
      <div class="form-group">
        <label for="oldPassword">Current Password</label>
        <input type="password" id="oldPassword" name="oldPassword" required>
      </div>
      <div class="form-group">
        <label for="newPassword">New Password</label>
        <input type="password" id="newPassword" name="newPassword" required>
      </div>
      <div class="form-group">
        <label for="confirmation">Confirm New Password</label>
        <input type="password" id="confirmation" name="confirmation" required>
      </div>
      <button type="submit" class="btn btn-primary">Update Password</button>
    </form>
  </div>

  <div id="email" class="tab-content <%= activeTab === 'email' ? 'active' : '' %>">
    <form action="/profile/email" method="POST">
      <div class="form-group">
        <label for="newEmail">New Email</label>
        <input type="email" id="newEmail" name="newEmail" required>
      </div>
      <div class="form-group">
        <label for="password">Current Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary">Update Email</button>
      <p class="form-hint">Your old email will be notified about this change.</p>
    </form>
  </div>

  <div class="profile-actions">
    <form action="/auth/logout" method="POST">
      <button type="submit" class="btn btn-danger">Logout</button>
    </form>
  </div>
</div>

<script>
  function openTab(tabName) {
    var tabs = document.querySelectorAll('.tab-content');
    for (var i = 0; i < tabs.length; i++) {
      tabs[i].classList.remove('active');
    }
    var btns = document.querySelectorAll('.tab-btn');
    for (var i = 0; i < btns.length; i++) {
      btns[i].classList.remove('active');
    }
    document.getElementById(tabName).classList.add('active');
    event.target.classList.add('active');
  }
</script>

<%- include('../partials/footer') %>
