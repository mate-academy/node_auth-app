<div class="profile-container">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card">
                <div class="card-header text-center">
                    <h3><i class="fas fa-envelope me-2"></i>Зміна електронної адреси</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        При зміні електронної адреси на стару пошту буде надіслано повідомлення про зміну.
                    </div>

                    <form action="/profile/change-email" method="POST">
                        <div class="mb-3">
                            <label for="currentEmail" class="form-label">Поточна електронна адреса</label>
                            <input type="email" class="form-control" value="<%= user.email %>" readonly>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Поточний пароль</label>
                            <input type="password" class="form-control" id="password"
                                   name="password" required>
                            <div class="form-text">
                                Введіть ваш поточний пароль для підтвердження
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="newEmail" class="form-label">Нова електронна адреса</label>
                            <input type="email" class="form-control" id="newEmail"
                                   name="newEmail" value="<%= locals.newEmail || '' %>" required>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="/profile" class="btn btn-secondary flex-fill">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </a>
                            <button type="submit" class="btn btn-info flex-fill">
                                <i class="fas fa-save me-2"></i>Змінити email
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
