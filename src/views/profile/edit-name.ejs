<div class="profile-container">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card">
                <div class="card-header text-center">
                    <h3><i class="fas fa-edit me-2"></i>Зміна імені</h3>
                </div>
                <div class="card-body">
                    <form action="/profile/edit-name" method="POST">
                        <div class="mb-3">
                            <label for="name" class="form-label">Поточне ім'я</label>
                            <input type="text" class="form-control" value="<%= user.name %>" readonly>
                        </div>

                        <div class="mb-3">
                            <label for="newName" class="form-label">Нове ім'я</label>
                            <input type="text" class="form-control" id="newName" name="name"
                                   value="<%= locals.name || user.name %>" required
                                   minlength="2" maxlength="50">
                            <div class="form-text">
                                Ім'я має бути від 2 до 50 символів
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="/profile" class="btn btn-secondary flex-fill">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </a>
                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="fas fa-save me-2"></i>Зберегти
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
