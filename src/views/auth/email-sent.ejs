<div class="auth-container">
    <div class="card">
        <div class="card-header text-center">
            <h3><i class="fas fa-envelope me-2"></i>Email надіслано</h3>
        </div>
        <div class="card-body text-center">
            <div class="mb-4">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <h4>Email успішно надіслано!</h4>
            </div>

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <%= message || 'Перевірте вашу електронну пошту для подальших інструкцій.' %>
            </div>

            <div class="mt-4">
                <a href="/auth/login" class="btn btn-primary">
                    <i class="fas fa-sign-in-alt me-2"></i>Перейти до входу
                </a>
            </div>
        </div>
        <div class="card-footer text-center">
            <p class="mb-0">
                <small class="text-muted">
                    Не отримали email? Перевірте папку "Спам" або
                    <a href="/auth/forgot-password" class="text-decoration-none">спробуйте ще раз</a>
                </small>
            </p>
        </div>
    </div>
</div>
