<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <title>Forgot password</title>
  </head>
  <body>
    <%- include('../components/header.ejs', {isAuthorize}) %>
    <main class="form-main">
      <form class="form">
        <h1 class="form-title">
          Enter email
        </h1>

        <div class="form-field">
          <label for="email" class="form-label">
            Email:
          </label>

            <input id="email" class="form-input" name="email" autocomplete="email" type="email" />
            <button class="form-button">Send</button>
        </div>
      </form>
    </main>

    <script type="module" src="/scripts/pages/forgotPassword.mjs"></script>
  </body>
</html>
