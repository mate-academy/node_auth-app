<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <title>Reset password</title>
  </head>
  <body>
    <%- include('../components/header.ejs', {isAuthorize}) %>
    <main class="form-main">
      <form class="form">
        <h1 class="form-title">
          Reset password
        </h1>

        <div class="form-field">
          <input hidden name="token" value="<%= token %>" >
          <label for="new-password" class="form-label">
            New password:
          </label>
          <input id="new-password" class="form-input" name="new-password" autocomplete="new-password" type="password" />

          <label for="confirm-password" class="form-label">
            Confirm password:
          </label>
          <input id="confirm-password" class="form-input" name="confirm-password" autocomplete="current-password" type="password" />

          <button class="form-button">Change password</button>
        </div>
      </form>
    </main>

    <script type="module" src="/scripts/pages/resetPassword.mjs"></script>
  </body>
</html>
