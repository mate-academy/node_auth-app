<div class="container text-center py-5">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3><i class="fas fa-exclamation-triangle me-2"></i>Помилка сервера</h3>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Сталася непередбачена помилка. Спробуйте оновити сторінку або повернутися пізніше.
                    </p>
                    <% if (error) { %>
                        <div class="alert alert-danger">
                            <strong>Деталі помилки:</strong><br>
                            <code><%= error %></code>
                        </div>
                    <% } %>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="/" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>На головну
                        </a>
                        <% if (user) { %>
                            <a href="/profile" class="btn btn-outline-primary">
                                <i class="fas fa-user me-2"></i>Профіль
                            </a>
                        <% } else { %>
                            <a href="/auth/login" class="btn btn-outline-primary">
                                <i class="fas fa-sign-in-alt me-2"></i>Увійти
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
