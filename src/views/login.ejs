<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вхід</title>
</head>
<body>
    <div style="text-align: center; margin-top: 50px; font-family: sans-serif;">
        <h1>Вхід у систему</h1>

        <form action="/login" method="POST" style="display: flex; flex-direction: column; width: 300px; margin: 0 auto;">
            <input type="email" name="email" placeholder="Email" required style="margin-bottom: 15px; padding: 10px;">
            <input type="password" name="password" placeholder="Пароль" required style="margin-bottom: 15px; padding: 10px;">
            <button type="submit" style="padding: 10px; cursor: pointer;">Увійти</button>
        </form>

    </div>
</body>
</html>
