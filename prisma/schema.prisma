generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenType {
  ACTIVATION
  RESET_PASSWORD
  CHANGE_EMAIL
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(false)
  newEmail     String?

  tokens       Token[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Token {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  type      TokenType
  expiresAt DateTime

  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
}
