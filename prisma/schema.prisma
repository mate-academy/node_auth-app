// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"              // mantenha sqlite (ou troque p/ postgresql se quiser)
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(cuid())
  name                    String
  email                   String   @unique
  passwordHash            String

  // Ativação
  isActive                Boolean  @default(false)
  activationToken         String?  @unique
  activationTokenExpires  DateTime?

  // Troca de e-mail
  pendingEmail            String?
  emailChangeToken        String?  @unique
  emailChangeTokenExpires DateTime?

  // Auditoria
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  passwordResets          PasswordReset[]
  refreshTokens           RefreshToken[]

  @@index([email])
  @@index([activationTokenExpires])
  @@index([emailChangeTokenExpires])
}

model PasswordReset {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
