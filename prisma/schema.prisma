generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  email           String   @unique
  password        String
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("users")
}
