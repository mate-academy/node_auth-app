generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DB_URL")
}

model User {
  id   String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name String
  password String
  activationToken String?  @map("activation_token")
  email String    @unique

  @@map("users")
}
