{
  "name": "node_auth-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Auth app",
  "main": "src/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/server.js",
    "init": "mate-scripts init",
    "preview": "vite preview",
    "build": "vite build",
    "start": "node server/server.js",
    "lint": "npm run lint:format && npm run lint:eslint",
    "lint:format": "prettier --check \"server/**/*.js\" \"client/src/**/*.{js,jsx}\" vite.config.js",
    "lint:eslint": "eslint --config .eslintrc.cjs server client/src vite.config.js",
    "format": "prettier --write \"server/**/*.js\" \"client/src/**/*.{js,jsx}\" vite.config.js",
    "test:only": "jest --passWithNoTests",
    "update": "mate-scripts update",
    "test": "npm run lint && npm run test:only"
  },
  "author": "Mate academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.3.2",
    "sequelize-cli": "^6.6.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "mateAcademy": {
    "projectType": "javascript"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bulma": "^1.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  }
}
