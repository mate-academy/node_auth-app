{
  "name": "fullstack-auth-app",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run start --workspace=server",
    "dev:client": "npm run start --workspace=client",
    "start-server": "npm run runapp --workspace=server",
    "start-client": "npm --workspace client start",
    "start": "concurrently \"npm run start-server\" \"npm run start-client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
