{
  "name": "node_auth-app",
  "version": "1.0.0",
  "description": "Auth app",
  "main": "server/index.js",
  "scripts": {
    "init": "mate-scripts init",
    "start": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "db:sync": "node server/scripts/syncDatabase.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "npm run format && mate-scripts lint",
    "format": "prettier --ignore-path .prettierignore --write './{client,server,src}/**/*.{js,jsx,ts,tsx}'",
    "test:only": "mate-scripts test",
    "update": "mate-scripts update",
    "test": "npm run lint && npm run test:only"
  },
  "author": "Mate academy",
  "license": "GPL-3.0",
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sequelize": "^6.37.7",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "^1.8.6",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.3.2"
  },
  "mateAcademy": {
    "projectType": "javascript"
  }
}
