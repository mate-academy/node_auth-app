# AWS RDS — Nest/pg adapter (PrismaService). Studio reads this via prisma.config.ts (strips schema/uselibpqcompat).
DATABASE_URL="postgresql://USER:PASSWORD@your-db.region.rds.amazonaws.com:5432/DATABASE?uselibpqcompat=true&sslmode=require"

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
CLIENT_URL=http://localhost:3000
PORT=3001

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
