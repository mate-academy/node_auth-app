{
  "info": {
    "name": "Auth API",
    "_postman_id": "node-auth-app-collection",
    "description": "Collection to test authentication and user endpoints for the node_auth-app server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password1\",\n  \"confirmPassword\": \"Password1\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/registration",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "registration"]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password1\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "sessions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Save accessToken to environment",
              "const json = pm.response.json();",
              "if (json && json.accessToken) {",
              "  pm.environment.set('accessToken', json.accessToken);",
              "}",
              "// show set cookie header for refresh token",
              "console.log('Set-Cookie:', pm.response.headers.get('set-cookie'))"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/sessions/tokens",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "sessions", "tokens"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.accessToken) {",
              "  pm.environment.set('accessToken', json.accessToken);",
              "}",
              "console.log('Refreshed access token')"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "sessions"]
        }
      }
    },
    {
      "name": "Activate (example token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/activations/{{activationToken}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "activations", "{{activationToken}}"]
        }
      }
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/password-resets",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "password-resets"]
        }
      }
    },
    {
      "name": "Reset Password (example token)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"password\": \"Newpass1\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/password-resets/confirmation/{{resetToken}}",
          "host": ["{{baseUrl}}"],
          "path": [
            "api",
            "v1",
            "auth",
            "password-resets",
            "confirmation",
            "{{resetToken}}"
          ]
        }
      }
    },
    {
      "name": "Change Password",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"previousPassword\": \"Password1\",\n  \"newPassword\": \"Password2\",\n  \"confirmPassword\": \"Password2\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "password"]
        }
      }
    },
    {
      "name": "Change Name",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newName\": \"Renamed User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/name",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "name"]
        }
      }
    },
    {
      "name": "Request Email Change",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newEmail\": \"new@example.com\",\n  \"password\": \"Password1\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/email-change",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "email-change"]
        }
      }
    },
    {
      "name": "Confirm Email Change (example token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/email-change/confirmation/{{emailChangeToken}}",
          "host": ["{{baseUrl}}"],
          "path": [
            "api",
            "v1",
            "users",
            "email-change",
            "confirmation",
            "{{emailChangeToken}}"
          ]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "activationToken", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "emailChangeToken", "value": "" }
  ]
}
